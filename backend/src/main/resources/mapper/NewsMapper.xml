<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jobnews.news.NewsMapper">

    <resultMap id="newsResultMap" type="com.jobnews.news.News">
        <id column="id" property="id"/>
        <result column="url" property="url"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="source" property="source"/>
        <result column="published_at" property="publishedAt"/>
        <result column="collected_at" property="collectedAt"/>
    </resultMap>

    <select id="existsByUrl" parameterType="string" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM news WHERE url = #{url})
    </select>

    <insert id="insert" parameterType="com.jobnews.news.News" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO news (url, title, description, source, published_at)
        VALUES (#{url}, #{title}, #{description}, #{source}, #{publishedAt, jdbcType=TIMESTAMP})
    </insert>

</mapper>
