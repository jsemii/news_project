<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    [전체 흐름에서의 위치] "저장" 단계에서 실제로 실행되는 SQL문들이 모여 있는 파일입니다.
    NewsMapper.java(자바 인터페이스)의 각 메서드 이름(existsByUrl, insert)과
    이 파일 안의 <select id="..."> / <insert id="..."> 의 id가 서로 짝을 이룹니다.
    즉 자바 코드에서 newsMapper.insert(news)를 부르면, 실제로는 아래 <insert id="insert"> 안의
    SQL문이 실행됩니다.
-->
<mapper namespace="com.jobnews.news.NewsMapper">

    <!--
        resultMap: DB 조회 결과(테이블의 컬럼들)를 자바 News 객체의 필드로 옮겨 담는 규칙입니다.
        예를 들어 DB의 published_at 컬럼 값을 News 객체의 publishedAt 필드에 넣으라는 뜻입니다.
        (지금은 existsByUrl만 쓰고 있어서 아직 실제로 사용되지는 않지만, 앞으로 "저장된 기사
        목록 조회" 같은 기능을 만들 때 이 resultMap을 재사용하게 됩니다.)
    -->
    <resultMap id="newsResultMap" type="com.jobnews.news.News">
        <id column="id" property="id"/>
        <result column="url" property="url"/>
        <result column="title" property="title"/>
        <result column="source" property="source"/>
        <result column="published_at" property="publishedAt"/>
        <result column="collected_at" property="collectedAt"/>
    </resultMap>

    <!--
        "URL 중복 제거"가 실제로 실행되는 SQL입니다.
        SELECT EXISTS(...) 는 "괄호 안 조건에 맞는 행이 하나라도 있으면 true, 없으면 false"를
        돌려주는 SQL 문법입니다. news 테이블 전체를 다 세는 COUNT(*) 대신 EXISTS를 쓰는 이유는,
        조건에 맞는 행을 하나 찾는 순간 바로 멈추기 때문에 더 빠르기 때문입니다.
        #{url} 은 자바에서 넘어온 url 값이 안전하게 바인딩되는 자리표시자입니다(SQL 인젝션 방지).
    -->
    <select id="existsByUrl" parameterType="string" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM news WHERE url = #{url})
    </select>

    <!--
        새 기사를 news 테이블에 저장하는 SQL입니다.
        id와 collected_at 컬럼은 여기서 값을 넣지 않는데, id는 BIGSERIAL(자동 채번),
        collected_at은 DEFAULT now()로 schema.sql에 정의되어 있어서 DB가 알아서 채워주기 때문입니다.
        useGeneratedKeys="true" keyProperty="id" 는 "DB가 자동으로 만든 id 값을
        저장 후에 News 객체의 id 필드로 다시 채워달라"는 뜻입니다.
    -->
    <insert id="insert" parameterType="com.jobnews.news.News" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO news (url, title, source, published_at)
        VALUES (#{url}, #{title}, #{source}, #{publishedAt, jdbcType=TIMESTAMP})
    </insert>

</mapper>
