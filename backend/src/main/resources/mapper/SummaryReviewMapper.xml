<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    [전체 흐름에서의 위치] QA 전용 조회 API의 SQL입니다. news와 news_analysis를
    news_id로 join해서, AI 요약 품질을 개발 중에 확인할 수 있는 최소 정보만 뽑습니다.
-->
<mapper namespace="com.jobnews.ai.SummaryReviewMapper">

    <resultMap id="summaryReviewRowMap" type="com.jobnews.ai.SummaryReviewRow">
        <result column="title" property="title"/>
        <result column="url" property="url"/>
        <result column="summary" property="summary"/>
        <result column="importance_score" property="importanceScore"/>
    </resultMap>

    <!--
        페이징 없이 collected_at(수집 시각) 최신순으로 50건만 가져옵니다. 원문(raw text)은
        news 테이블에 애초에 없으므로 이 쿼리로도 절대 노출되지 않습니다.
    -->
    <select id="selectRecentSummaries" resultMap="summaryReviewRowMap">
        SELECT n.title, n.url, na.summary, na.importance_score
        FROM news n
        JOIN news_analysis na ON na.news_id = n.id
        ORDER BY n.collected_at DESC
        LIMIT 50
    </select>

</mapper>
