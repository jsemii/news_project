<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    [전체 흐름에서의 위치] "직무별 맞춤 브리핑" 조회 단계의 SQL입니다.
-->
<mapper namespace="com.jobnews.briefing.BriefingMapper">

    <resultMap id="briefingRowMap" type="com.jobnews.briefing.BriefingRow">
        <result column="news_id" property="newsId"/>
        <result column="title" property="title"/>
        <result column="url" property="url"/>
        <result column="published_at" property="publishedAt"/>
        <result column="summary" property="summary"/>
        <result column="importance_score" property="importanceScore"/>
        <result column="industries_csv" property="industriesCsv"/>
    </resultMap>

    <!--
        news_analysis와 news를 조인해서 요약/중요도 점수를 가져오고, news_industry는
        LEFT JOIN + string_agg(콤마로 이어붙이는 PostgreSQL 집계 함수)로 한 줄짜리
        문자열로 합칩니다 — 뉴스 1건에 산업이 여러 개 붙어도 결과 행이 뉴스 1건당
        1행으로 유지되게 하기 위함입니다(GROUP BY 필요). analyzed_at::date = CURRENT_DATE로
        "오늘 분석된 것"만 걸러내고, importance_score 내림차순으로 정렬해 상위 N건만 가져옵니다.
    -->
    <select id="selectTopBriefings" resultMap="briefingRowMap">
        SELECT
            n.id AS news_id,
            n.title AS title,
            n.url AS url,
            n.published_at AS published_at,
            na.summary AS summary,
            na.importance_score AS importance_score,
            string_agg(DISTINCT ni.industry, ',') AS industries_csv
        FROM news n
        JOIN news_analysis na ON na.news_id = n.id
        LEFT JOIN news_industry ni ON ni.news_id = n.id
        WHERE na.analyzed_at::date = CURRENT_DATE
        GROUP BY n.id, n.title, n.url, n.published_at, na.summary, na.importance_score
        ORDER BY na.importance_score DESC
        LIMIT #{limit}
    </select>

    <resultMap id="jobBriefingRowMap" type="com.jobnews.briefing.BriefingRow">
        <result column="news_id" property="newsId"/>
        <result column="title" property="title"/>
        <result column="url" property="url"/>
        <result column="published_at" property="publishedAt"/>
        <result column="summary" property="summary"/>
        <result column="importance_score" property="importanceScore"/>
        <result column="industries_csv" property="industriesCsv"/>
        <result column="job" property="job"/>
        <result column="why_it_matters" property="whyItMatters"/>
        <result column="key_skills" property="keySkills"/>
    </resultMap>

    <!--
        selectTopBriefings와 거의 같지만, news_job_analysis를 news_id + job(파라미터)
        조건으로 INNER JOIN해서 그 직무 관점의 재해석(why_it_matters, key_skills)도
        함께 가져옵니다. INNER JOIN을 쓰는 이유: NewsAnalysisSaver.save()가
        news_analysis와 3개 직무 행을 항상 같은 트랜잭션에서 함께 저장하므로,
        news_analysis가 있는 뉴스는 반드시 이 조인 조건에 맞는 직무 행도 존재합니다 —
        그래서 이 쿼리로도 selectTopBriefings와 같은 뉴스 건수가 나옵니다(내용만 다름).
        job/why_it_matters/key_skills도 GROUP BY에 넣는 이유는 이 값들이 string_agg처럼
        집계되는 컬럼이 아니라서(뉴스+직무 조합마다 값이 하나뿐이긴 하지만) PostgreSQL이
        SELECT에 있는 비집계 컬럼은 GROUP BY에도 명시하도록 요구하기 때문입니다.
    -->
    <select id="selectTopBriefingsByJob" resultMap="jobBriefingRowMap">
        SELECT
            n.id AS news_id,
            n.title AS title,
            n.url AS url,
            n.published_at AS published_at,
            na.summary AS summary,
            na.importance_score AS importance_score,
            string_agg(DISTINCT ni.industry, ',') AS industries_csv,
            ja.job AS job,
            ja.why_it_matters AS why_it_matters,
            ja.key_skills AS key_skills
        FROM news n
        JOIN news_analysis na ON na.news_id = n.id
        JOIN news_job_analysis ja ON ja.news_id = n.id AND ja.job = #{job}
        LEFT JOIN news_industry ni ON ni.news_id = n.id
        WHERE na.analyzed_at::date = CURRENT_DATE
        GROUP BY n.id, n.title, n.url, n.published_at, na.summary, na.importance_score,
                 ja.job, ja.why_it_matters, ja.key_skills
        ORDER BY na.importance_score DESC
        LIMIT #{limit}
    </select>

</mapper>
