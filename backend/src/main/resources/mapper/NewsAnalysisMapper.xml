<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    [전체 흐름에서의 위치] "AI 뉴스 구조화" 단계의 SQL 모음입니다. NewsAnalysisMapper.java의
    메서드 이름과 이 파일의 id가 짝을 이룹니다(뉴스 저장 단계의 NewsMapper.xml과 같은 구조).
-->
<mapper namespace="com.jobnews.ai.NewsAnalysisMapper">

    <select id="existsByNewsId" parameterType="long" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM news_analysis WHERE news_id = #{newsId})
    </select>

    <!--
        resultMap="com.jobnews.news.NewsMapper.newsResultMap": 이 파일에서 새로 컬럼 매핑
        규칙을 다시 만들지 않고, news 저장 단계(NewsMapper.xml)에 이미 정의되어 있는
        resultMap을 그대로 가져다 씁니다. 같은 news 테이블 구조를 두 번 적을 필요가 없기
        때문입니다(중복 방지).
    -->
    <!--
        news_analysis(AI가 실제로 분석한 것)와 news_filtered_out(규칙 기반 필터가 걸러낸 것)
        둘 다에 없는 뉴스만 "아직 처리 안 됨"으로 봅니다. 필터링된 뉴스도 news_filtered_out에
        표시가 남으므로, 여기서 제외되어 다시는 이 목록에 걸리지 않습니다.
    -->
    <select id="selectUnanalyzedNews" resultMap="com.jobnews.news.NewsMapper.newsResultMap">
        SELECT n.*
        FROM news n
        LEFT JOIN news_analysis a ON a.news_id = n.id
        LEFT JOIN news_filtered_out f ON f.news_id = n.id
        WHERE a.news_id IS NULL AND f.news_id IS NULL
        ORDER BY n.collected_at ASC
        LIMIT #{limit}
    </select>

    <select id="countUnanalyzedNews" resultType="int">
        SELECT count(*)
        FROM news n
        LEFT JOIN news_analysis a ON a.news_id = n.id
        LEFT JOIN news_filtered_out f ON f.news_id = n.id
        WHERE a.news_id IS NULL AND f.news_id IS NULL
    </select>

    <insert id="insertFilteredOut">
        INSERT INTO news_filtered_out (news_id, reason) VALUES (#{newsId}, #{reason})
        ON CONFLICT (news_id) DO NOTHING
    </insert>

    <insert id="insertAnalysis" parameterType="com.jobnews.ai.NewsAnalysis">
        INSERT INTO news_analysis (news_id, summary, importance_score)
        VALUES (#{newsId}, #{summary}, #{importanceScore})
    </insert>

    <!--
        <foreach>: 리스트 안의 항목 개수만큼 "(값1, 값2)" 형태를 반복해서 이어붙여,
        INSERT INTO ... VALUES (...), (...), (...) 처럼 여러 행을 SQL 한 번으로 넣습니다.
        메서드 파라미터가 @Param 없이 List 하나뿐이면 MyBatis가 이를 자동으로 "list"라는
        이름으로 넘겨줍니다.
    -->
    <insert id="insertIndustries" parameterType="list">
        INSERT INTO news_industry (news_id, industry)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.newsId}, #{item.industry})
        </foreach>
    </insert>

    <insert id="insertJobAnalyses" parameterType="list">
        INSERT INTO news_job_analysis (news_id, job, why_it_matters, key_skills)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.newsId}, #{item.job}, #{item.whyItMatters}, #{item.keySkills})
        </foreach>
    </insert>

</mapper>
